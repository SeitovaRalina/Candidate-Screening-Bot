TELEGRAM_BOT_TOKEN=

# Only needed if the server can't reach api.telegram.org directly (common for
# Russian server IPs). http://user:pass@host:port or socks5://... (socks5
# needs `pip install httpx[socks]` too). Leave empty otherwise.
PROXY_URL=

# ANTHROPIC_API_KEY here is the LiteLLM gateway's virtual key (get one from
# whoever admins llm.effective.land), not a raw console.anthropic.com key.
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=https://llm.effective.land
ANTHROPIC_MODEL=claude-sonnet-5

# Leave false in any deployed instance - client requirement, no candidate data
# in logs, even temporarily. Set true only on your own machine for debugging.
LOCAL_DEBUG_LOGGING=false
